{
  "name": "linguaflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "bun --filter @linguaflow/mobile dev",
    "dev:api": "bun --filter @linguaflow/api dev",
    "build:mobile": "bun --filter @linguaflow/mobile build",
    "build:shared": "bun --filter @linguaflow/shared build",
    "android:dev": "bun --filter @linguaflow/mobile android:dev",
    "android:build": "bun --filter @linguaflow/mobile android:build",
    "ios:dev": "bun --filter @linguaflow/mobile ios:dev",
    "ios:build": "bun --filter @linguaflow/mobile ios:build",
    "deploy:api": "bun --filter @linguaflow/api deploy",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "bun@1.3.13"
}
