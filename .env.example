# =============================================================================
# Supabase (used by mobile client + Lambda backend)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# AI providers (backend only)
# =============================================================================
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.0-flash-001

OPENAI_API_KEY=sk-...

# =============================================================================
# Azure Speech (pronunciation assessment, backend only)
# =============================================================================
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=westeurope

# =============================================================================
# Mobile app (Vite, baked into the APK at build time)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_API_URL=https://your-deployed-api.execute-api.eu-central-1.amazonaws.com
